<UserControl x:Class="WolManager.Controls.StatusIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:WolManager.Models"
             x:Name="Root">
    <UserControl.Resources>
        <Style x:Key="DotStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="{StaticResource StatusUnknownBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="{x:Static models:PcStatus.On}">
                    <Setter Property="Fill" Value="{StaticResource StatusOnBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="{x:Static models:PcStatus.Waking}">
                    <Setter Property="Fill" Value="{StaticResource StatusWakingBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="{x:Static models:PcStatus.Off}">
                    <Setter Property="Fill" Value="{StaticResource StatusOffBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="{x:Static models:PcStatus.ShuttingDown}">
                    <Setter Property="Fill" Value="{StaticResource StatusWakingBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="알 수 없음" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="{x:Static models:PcStatus.On}">
                    <Setter Property="Text" Value="켜짐" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="{x:Static models:PcStatus.Waking}">
                    <Setter Property="Text" Value="깨우는 중" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="{x:Static models:PcStatus.Off}">
                    <Setter Property="Text" Value="응답 없음" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status, ElementName=Root}" Value="{x:Static models:PcStatus.ShuttingDown}">
                    <Setter Property="Text" Value="끄는 중" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Ellipse Width="9" Height="9" Margin="0,0,7,0" VerticalAlignment="Center" Style="{StaticResource DotStyle}" />
        <TextBlock VerticalAlignment="Center" Style="{StaticResource LabelStyle}" />
    </StackPanel>
</UserControl>
