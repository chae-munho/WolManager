<Window x:Class="WolManager.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:WolManager.Services"
        xmlns:behaviors="clr-namespace:WolManager.Behaviors"
        Title="{Binding Title}"
        Width="470"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource DefaultFont}"
        FontSize="{StaticResource DefaultFontSize}"
        Foreground="{StaticResource TextPrimaryBrush}"
        behaviors:WindowDragBehavior.IsEnabled="True"
        behaviors:DialogCloseBehavior.DialogResult="{Binding Result}">
    <Window.Resources>
        <Style x:Key="IconCircleStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static services:DialogKind.Warning}">
                    <Setter Property="Background" Value="{StaticResource StatusWakingBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- 그림자가 보이도록 바깥 여백을 둔다 -->
    <Border Margin="16" Style="{StaticResource CardStyle}" Padding="22,20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.22" />
        </Border.Effect>
        <StackPanel>
            <DockPanel Margin="0,0,0,18">
                <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="19" Margin="0,0,14,0"
                        VerticalAlignment="Top" Style="{StaticResource IconCircleStyle}">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource OnAccentBrush}" Text="{Binding IconText}" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{Binding Title}" />
                    <TextBlock Margin="0,6,0,0" LineHeight="20" TextWrapping="Wrap" Text="{Binding Message}" />
                </StackPanel>
            </DockPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Margin="0,0,8,0" MinWidth="80" IsCancel="True"
                        Content="{Binding CancelText}" Command="{Binding CancelCommand}"
                        Visibility="{Binding HasCancel, Converter={StaticResource BoolToVisibility}}" />
                <Button MinWidth="80" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}"
                        Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
