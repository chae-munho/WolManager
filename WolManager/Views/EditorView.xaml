<UserControl x:Class="WolManager.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabelTextStyle}" Text="이름" />
            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldLabelTextStyle}" Text="MAC" />
            <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource FieldLabelTextStyle}" Text="IP (모르면 비워 두기)" />

            <TextBox Grid.Row="1" Grid.Column="0" Margin="0,0,8,0"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,8,0"
                     Style="{StaticResource MonoTextBoxStyle}"
                     Text="{Binding Mac, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Grid.Row="1" Grid.Column="2" Margin="0,0,12,0"
                     Style="{StaticResource MonoTextBoxStyle}"
                     Text="{Binding Ip, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal">
                <Button Content="새로 입력" Margin="0,0,6,0" Command="{Binding NewCommand}" />
                <Button Content="추가" Margin="0,0,6,0" Command="{Binding AddCommand}" />
                <Button Content="수정" Margin="0,0,6,0" Command="{Binding UpdateCommand}" />
                <Button Content="삭제" Command="{Binding DeleteCommand}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
