<UserControl x:Class="WolManager.Views.AddPcView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}">
    <!-- 뒤 화면을 흐리게 덮고 가운데에 추가 창을 띄운다 -->
    <Grid Background="{StaticResource OverlayBrush}">
        <Border Width="360" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardStyle}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.18" />
            </Border.Effect>
            <StackPanel>
                <TextBlock Margin="0,0,0,14" Style="{StaticResource SectionTitleTextStyle}" Text="새 PC 추가" />

                <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="이름" />
                <TextBox Margin="0,0,0,10" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="MAC" />
                <TextBox Margin="0,0,0,10" Style="{StaticResource MonoTextBoxStyle}"
                         Text="{Binding Mac, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="IP (모르면 비워 두기)" />
                <TextBox Margin="0,0,0,16" Style="{StaticResource MonoTextBoxStyle}"
                         Text="{Binding Ip, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="취소" Margin="0,0,8,0" Command="{Binding CancelCommand}" />
                    <Button Content="추가" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
