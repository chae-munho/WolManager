<UserControl x:Class="WolManager.Views.PcListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:WolManager.Models"
             xmlns:behaviors="clr-namespace:WolManager.Behaviors"
             xmlns:controls="clr-namespace:WolManager.Controls">
    <UserControl.Resources>
        <!-- 상태에 따라 모니터 색을 바꾸고, 깨우는 중/끄는 중에는 깜빡인다 -->
        <Style x:Key="MonitorStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource StatusUnknownBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:PcStatus.On}">
                    <Setter Property="Background" Value="{StaticResource StatusOnBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:PcStatus.Off}">
                    <Setter Property="Background" Value="{StaticResource StatusOffBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:PcStatus.Waking}">
                    <Setter Property="Background" Value="{StaticResource StatusWakingBrush}" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="WakingBlink">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35"
                                                 Duration="0:0:0.7" AutoReverse="True" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="WakingBlink" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:PcStatus.ShuttingDown}">
                    <Setter Property="Background" Value="{StaticResource StatusWakingBrush}" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="ShuttingDownBlink">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35"
                                                 Duration="0:0:0.7" AutoReverse="True" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="ShuttingDownBlink" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 카드가 작아지면 내용도 같이 줄어든다 (커지지는 않는다) -->
        <DataTemplate x:Key="PcTileTemplate" DataType="{x:Type models:PcEntry}">
            <Viewbox StretchDirection="DownOnly">
            <StackPanel Width="116" VerticalAlignment="Center" ToolTip="{Binding Mac}">
                <!-- 모니터 아이콘: 화면, 받침대 -->
                <Grid Width="48" Height="40" HorizontalAlignment="Center" Margin="0,0,0,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border x:Name="Screen" CornerRadius="3" Style="{StaticResource MonitorStyle}">
                        <Border Margin="4" CornerRadius="1" Background="{StaticResource CardBrush}" Opacity="0.35" />
                    </Border>
                    <Border Grid.Row="1" Width="20" Height="4" VerticalAlignment="Bottom" CornerRadius="1"
                            Background="{Binding Background, ElementName=Screen}" />
                </Grid>
                <TextBlock Style="{StaticResource TileNameTextStyle}" Text="{Binding Name}" />
                <TextBlock Style="{StaticResource TileIpTextStyle}" Text="{Binding Ip}" />
            </StackPanel>
            </Viewbox>
        </DataTemplate>

        <!-- 대수에 맞춰 한 줄 개수를 정하고, 카드가 영역을 고르게 나눠 채운다 -->
        <ItemsPanelTemplate x:Key="PcTilePanel">
            <UniformGrid Columns="{Binding DataContext.TileColumns, RelativeSource={RelativeSource AncestorType=ListBox}}"
                         VerticalAlignment="Top" />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Border Style="{StaticResource CardStyle}">
        <DockPanel>
            <!-- 제목, 상태 요약, 버튼 -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="상태 새로고침" Margin="0,0,8,0" Command="{Binding RefreshCommand}" />
                    <Button Content="새 PC 추가" Margin="0,0,8,0" Command="{Binding AddCommand}" />
                    <Button Content="전체 깨우기" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding WakeAllCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="PC 목록" />

                    <!-- 상태별 대수: 카드 아이콘과 같은 색 점 + 상태 + 대수 -->
                    <ItemsControl Margin="16,0,0,0" VerticalAlignment="Center" ItemsSource="{Binding StatusCounts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:StatusCount}">
                                <StackPanel Margin="0,0,16,0" Orientation="Horizontal">
                                    <controls:StatusIndicator Status="{Binding Status}" />
                                    <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                                               Text="{Binding Count, StringFormat={}{0}대}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DockPanel>

            <Grid>
                <ListBox ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedPc}"
                         Style="{StaticResource PcTileListStyle}"
                         ItemContainerStyle="{StaticResource PcTileItemStyle}"
                         ItemTemplate="{StaticResource PcTileTemplate}"
                         ItemsPanel="{StaticResource PcTilePanel}"
                         behaviors:ListBoxSelectAllBehavior.IsAllSelected="{Binding IsAllSelected}" />

                <!-- 목록이 비어 있을 때 안내 -->
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Text="대상 PC를 모두 켠 뒤 네트워크 스캔을 누르세요.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource HintTextStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
