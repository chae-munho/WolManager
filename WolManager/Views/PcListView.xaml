<UserControl x:Class="WolManager.Views.PcListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WolManager.Controls">
    <Border Style="{StaticResource CardStyle}">
        <DockPanel>
            <!-- 제목과 버튼 -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="상태 새로고침" Margin="0,0,8,0" Command="{Binding RefreshCommand}" />
                    <Button Content="전체 깨우기" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding WakeAllCommand}" />
                </StackPanel>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitleTextStyle}" Text="PC 목록" />
            </DockPanel>

            <Grid>
                <DataGrid ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedPc}"
                          Style="{StaticResource PcGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="대상" Width="56">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsTarget, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="전체 깨우기에 포함" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="상태" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:StatusIndicator Status="{Binding Status}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="이름" Width="*" Binding="{Binding Name}"
                                            ElementStyle="{StaticResource GridCellTextStyle}" />
                        <DataGridTextColumn Header="MAC" Width="170" Binding="{Binding Mac}"
                                            ElementStyle="{StaticResource GridMonoCellTextStyle}" />
                        <DataGridTextColumn Header="IP" Width="140" Binding="{Binding Ip}"
                                            ElementStyle="{StaticResource GridMonoCellTextStyle}" />

                        <DataGridTemplateColumn Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="깨우기"
                                            Style="{StaticResource SmallButtonStyle}"
                                            Command="{Binding DataContext.WakeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 목록이 비어 있을 때 안내 -->
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Text="대상 PC를 모두 켠 뒤 네트워크 스캔을 누르세요.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource HintTextStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
